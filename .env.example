# Last.fm
LASTFM_USER=your_lastfm_username
LASTFM_API_KEY=your_lastfm_api_key

# Discord
DISCORD_APP_ID=your_application_id
DISCORD_USER_ID=your_user_id
DISCORD_BOT_TOKEN=your_bot_token

# Optional
# FORCE_MODE=music        # music | personal (default: automatic)
# UPDATE_INTERVAL=30      # seconds between checks (min 10)
# STATS_TTL=300           # seconds to cache Last.fm totals (min 30)
# DASHBOARD_PASSWORD=     # set (8+ chars) to enable the web settings page
# DASHBOARD_PORT=3000     # panels that set SERVER_PORT/PORT use that automatically
# DASHBOARD_HOST=         # default 127.0.0.1 locally, 0.0.0.0 on a panel
# DASHBOARD_TRUST_PROXY=1 # only behind a reverse proxy: use its X-Forwarded-For for the lockout
